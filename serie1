<script>
const TOTAL = 10;
const done = new Set(JSON.parse(localStorage.getItem('py2_done') || '[]'));

document.addEventListener('DOMContentLoaded', () => {
  done.forEach(id => applyDone(id));
  updateProgress();
});

function toggle(id) {
  document.getElementById(id).classList.toggle('open');
}

function toggleAcc(id) {
  document.getElementById(id).classList.toggle('open');
}

function markDone(id) {
  if (done.has(id)) {
    done.delete(id);
    const card = document.getElementById(id);
    card.classList.remove('done');
    const btn = card.querySelector('.done-btn');
    btn.querySelector('.done-icon').textContent = '○';
    btn.childNodes[1].textContent = ' Marquer comme fait';
  } else {
    done.add(id);
    applyDone(id);
  }
  localStorage.setItem('py2_done', JSON.stringify([...done]));
  updateProgress();
}

function applyDone(id) {
  const card = document.getElementById(id);
  if (!card) return;
  card.classList.add('done');
  const btn = card.querySelector('.done-btn');
  btn.querySelector('.done-icon').textContent = '✓';
  btn.childNodes[1].textContent = ' Exercice complété !';
}

function updateProgress() {
  const n = done.size;
  document.getElementById('progressBar').style.width = (n / TOTAL * 100) + '%';
  document.getElementById('progressTxt').textContent = n + ' / ' + TOTAL;
}

function filter(tag, el) {
  document.querySelectorAll('.pill').forEach(p => p.classList.remove('active'));
  el.classList.add('active');
  document.querySelectorAll('.card').forEach(card => {
    if (tag === 'all' || card.dataset.tags.includes(tag)) {
      card.style.display = '';
    } else {
      card.style.display = 'none';
      card.classList.remove('open');
    }
  });
}
</script>
