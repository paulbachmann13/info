notes    <span class="op">=</span> [<span class="num">15</span>, <span class="num">11</span>, <span class="num">13</span>, <span class="num">17</span>, <span class="num">9</span>]

<span class="fn">afficher_bulletin</span>(matieres, notes)
<span class="bi">print</span>()
<span class="bi">print</span>(<span class="fn">f</span><span class="str">"Moyenne : {moyenne(notes)}"</span>)
<span class="bi">print</span>(<span class="fn">f</span><span class="str">"Meilleure note : {meilleure_note(notes)}"</span>)</pre>
        </div>
      </div>
