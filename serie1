          <pre><span class="cm"># Fonction mention (de l'exo 6)</span>
<span class="kw">def</span> <span class="fn">mention</span>(note) <span class="op">:</span>
    <span class="kw">if</span> note <span class="op">&lt;</span> <span class="num">10</span>  <span class="op">:</span> <span class="ret">return</span> <span class="str">"Insuffisant"</span>
    <span class="kw">elif</span> note <span class="op">&lt;</span> <span class="num">12</span> <span class="op">:</span> <span class="ret">return</span> <span class="str">"Passable"</span>
    <span class="kw">elif</span> note <span class="op">&lt;</span> <span class="num">14</span> <span class="op">:</span> <span class="ret">return</span> <span class="str">"Assez bien"</span>
    <span class="kw">elif</span> note <span class="op">&lt;</span> <span class="num">16</span> <span class="op">:</span> <span class="ret">return</span> <span class="str">"Bien"</span>
    <span class="kw">else</span>           <span class="op">:</span> <span class="ret">return</span> <span class="str">"Très bien"</span>

<span class="kw">def</span> <span class="fn">afficher_bulletin</span>(matieres, notes) <span class="op">:</span>
    <span class="bi">print</span>(<span class="str">"=== Bulletin ==="</span>)
    <span class="kw">for</span> i <span class="kw">in</span> <span class="bi">range</span>(<span class="bi">len</span>(matieres)) <span class="op">:</span>
        m <span class="op">=</span> matieres[i]
        n <span class="op">=</span> notes[i]
        <span class="bi">print</span>(<span class="fn">f</span><span class="str">"{m:10} : {n}  — {mention(n)}"</span>)

<span class="kw">def</span> <span class="fn">moyenne</span>(notes) <span class="op">:</span>
