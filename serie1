        <div class="accordion-body">
          <pre><span class="kw">def</span> <span class="fn">somme</span>(n) <span class="op">:</span>
    total <span class="op">=</span> <span class="num">0</span>
    <span class="kw">for</span> i <span class="kw">in</span> <span class="bi">range</span>(<span class="num">1</span>, n <span class="op">+</span> <span class="num">1</span>) <span class="op">:</span>
        total <span class="op">+=</span> i
    <span class="ret">return</span> total

<span class="bi">print</span>(<span class="fn">f</span><span class="str">"somme(5) = {somme(5)}"</span>)
